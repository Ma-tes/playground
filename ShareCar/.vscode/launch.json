{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BackendService.App",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/src/ShareCar.BackendService.App/bin/Debug/net8.0/ShareCar.BackendService.App.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ShareCar.BackendService.App",
      "externalConsole": true,
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7153;http://localhost:5076"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "https://localhost:7153",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start https://localhost:7153"
        }
      }
    },
    {
      "name": "WebClient.App",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-webclient",
      "program": "${workspaceFolder}/src/ShareCar.WebClient.App/bin/Debug/net8.0/ShareCar.WebClient.App.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ShareCar.WebClient.App",
      "externalConsole": true,
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7167;http://localhost:5026"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "https://localhost:7167",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start https://localhost:7167"
        }
      }
    }
  ],
  "compounds": [
    {
      "name": "Backend + WebClient",
      "configurations": [
        "BackendService.App",
        "WebClient.App"
      ]
    }
  ]
}
