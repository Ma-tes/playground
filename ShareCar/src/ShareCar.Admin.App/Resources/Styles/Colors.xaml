<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Matches WebClient site.css :root variables exactly -->
    <Color x:Key="PageBackground">#F6F1EE</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#EDE8E3</Color>
    <Color x:Key="Accent">#D2691E</Color>
    <Color x:Key="AccentDark">#A0522D</Color>
    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextMuted">#7A7068</Color>
    <Color x:Key="TextFaint">#B0A898</Color>
    <Color x:Key="BorderColor">#D8D0C8</Color>
    <Color x:Key="Border2Color">#C0B8AE</Color>
    <Color x:Key="HeaderBg">#1A1A1A</Color>
    <Color x:Key="ErrorColor">#9A2020</Color>
    <Color x:Key="SuccessColor">#2A6A1E</Color>
    <Color x:Key="ErrorBg">#FDF5F3</Color>
    <Color x:Key="SuccessBg">#F3F9EE</Color>
    <Color x:Key="WarnColor">#7A5000</Color>
    <Color x:Key="WarnBg">#FDF8EE</Color>

</ResourceDictionary>