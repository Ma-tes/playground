<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Base styles matching WebClient Retro Apple Light Theme ── -->

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextFaint}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextFaint}" />
    </Style>

    <!-- ── Primary button: dark bg like WebClient .bg-blue-600 ── -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <!-- ── Secondary button: transparent with border ── -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <!-- ── Sort button: small, outlined ── -->
    <Style x:Key="SortButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HeightRequest" Value="28" />
    </Style>

    <!-- ── Table header: dark bg, white monospace text ── -->
    <Style x:Key="TableHeaderLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TableCellStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TableCellMutedStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ── Error banner: warm error bg ── -->
    <Style x:Key="ErrorBannerStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorBg}" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="SuccessBannerStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SuccessBg}" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="FieldErrorLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- ── Danger button: error-colored outline ── -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
        <Setter Property="BorderColor" Value="{StaticResource ErrorColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HeightRequest" Value="28" />
    </Style>

    <!-- ── Warn button: amber/warn style ── -->
    <Style x:Key="WarnButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{StaticResource WarnColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderColor" Value="{StaticResource WarnColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <!-- ── Accent button (block/action) ── -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <!-- ── Shell: dark nav like WebClient header ── -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource HeaderBg}" />
        <Setter Property="Shell.ForegroundColor" Value="White" />
        <Setter Property="Shell.TitleColor" Value="White" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource HeaderBg}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Accent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="White" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextFaint}" />
    </Style>

</ResourceDictionary>
