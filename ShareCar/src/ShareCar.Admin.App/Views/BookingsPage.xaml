<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShareCar.Admin.App.Views.BookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ShareCar.Admin.App.Models"
    xmlns:viewmodels="clr-namespace:ShareCar.Admin.App.ViewModels"
    x:DataType="viewmodels:BookingsViewModel"
    Title="BOOKINGS"
    BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="REFRESH" Command="{Binding LoadCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- Messages -->
        <Label Grid.Row="0" IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerStyle}" />
        <Label Grid.Row="0" IsVisible="{Binding HasSuccess}" Text="{Binding SuccessMessage}" Style="{StaticResource SuccessBannerStyle}" />

        <!-- Sort bar -->
        <Grid
            Grid.Row="1"
            BackgroundColor="{StaticResource SurfaceColor}"
            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
            Padding="16,10"
            ColumnSpacing="8">
            <Label Grid.Column="0" Text="SORT:" FontFamily="Courier New" FontSize="11" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="START" Command="{Binding SortCommand}" CommandParameter="StartTime" Style="{StaticResource SortButtonStyle}" />
            <Button Grid.Column="2" Text="END" Command="{Binding SortCommand}" CommandParameter="EndTime" Style="{StaticResource SortButtonStyle}" />
            <Button Grid.Column="3" Text="USER" Command="{Binding SortCommand}" CommandParameter="UserId" Style="{StaticResource SortButtonStyle}" />
            <Button Grid.Column="4" Text="VEHICLE" Command="{Binding SortCommand}" CommandParameter="VehicleId" Style="{StaticResource SortButtonStyle}" />
            <ActivityIndicator Grid.Column="6" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" VerticalOptions="Center" />
        </Grid>

        <!-- Table header -->
        <Grid
            Grid.Row="2"
            BackgroundColor="{StaticResource HeaderBg}"
            ColumnDefinitions="40,50,50,130,130,70,70,70,60"
            Padding="16,8">
            <Label Grid.Column="0" Text="ID" Style="{StaticResource TableHeaderLabelStyle}" />
            <Label Grid.Column="1" Text="USR" Style="{StaticResource TableHeaderLabelStyle}" />
            <Label Grid.Column="2" Text="VEH" Style="{StaticResource TableHeaderLabelStyle}" />
            <Label Grid.Column="3" Text="START" Style="{StaticResource TableHeaderLabelStyle}" />
            <Label Grid.Column="4" Text="END" Style="{StaticResource TableHeaderLabelStyle}" />
            <Label Grid.Column="5" Text="S.ODO" Style="{StaticResource TableHeaderLabelStyle}" />
            <Label Grid.Column="6" Text="E.ODO" Style="{StaticResource TableHeaderLabelStyle}" />
            <Label Grid.Column="7" Text="PRICE" Style="{StaticResource TableHeaderLabelStyle}" />
            <Label Grid.Column="8" Text="LIVE" Style="{StaticResource TableHeaderLabelStyle}" />
        </Grid>

        <!-- List -->
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Bookings}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedBooking}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BookingItem">
                    <VerticalStackLayout Spacing="0">
                        <Grid
                            ColumnDefinitions="40,50,50,130,130,70,70,70,60"
                            Padding="16,10"
                            BackgroundColor="{StaticResource SurfaceColor}">
                            <Label Grid.Column="0" Text="{Binding Id}" Style="{StaticResource TableCellMutedStyle}" />
                            <Label Grid.Column="1" Text="{Binding UserId}" Style="{StaticResource TableCellStyle}" />
                            <Label Grid.Column="2" Text="{Binding VehicleId}" Style="{StaticResource TableCellStyle}" />
                            <Label Grid.Column="3" Text="{Binding StartTime, StringFormat='{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource TableCellStyle}" />
                            <Label Grid.Column="4" Text="{Binding EndTime, StringFormat='{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource TableCellMutedStyle}" />
                            <Label Grid.Column="5" Text="{Binding StartOdometer}" Style="{StaticResource TableCellMutedStyle}" />
                            <Label Grid.Column="6" Text="{Binding EndOdometer}" Style="{StaticResource TableCellMutedStyle}" />
                            <Label Grid.Column="7" Text="{Binding TotalPrice, StringFormat='{0:F2}'}" Style="{StaticResource TableCellStyle}" />
                            <Label Grid.Column="8" Text="{Binding IsActive}" Style="{StaticResource TableCellStyle}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Pagination -->
        <Grid
            Grid.Row="4"
            BackgroundColor="{StaticResource SurfaceColor}"
            ColumnDefinitions="Auto,*,Auto,*,Auto"
            Padding="16,10">
            <Button Grid.Column="0" Text="◀ PREV" Command="{Binding PrevPageCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            <Label Grid.Column="2" Text="{Binding CurrentPage, StringFormat='PAGE {0}'}" FontFamily="Courier New" FontSize="11" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="4" Text="NEXT ▶" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <!-- Detail panel (read-only for completed) -->
        <Border
            Grid.Row="5"
            IsVisible="{Binding HasSelection}"
            BackgroundColor="{StaticResource SurfaceColor}"
            Stroke="{StaticResource BorderColor}"
            StrokeThickness="1"
            StrokeShape="Rectangle"
            Padding="16,14">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <BoxView Grid.Row="0" HeightRequest="3" BackgroundColor="{StaticResource Accent}" Margin="0,0,0,8" />
                <Label Grid.Row="1" Text="BOOKING DETAIL" FontFamily="Courier New" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                <Grid Grid.Row="2" ColumnDefinitions="100,200,100,200" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0" Text="Start Lot:" FontFamily="Courier New" FontSize="13" TextColor="{StaticResource TextMuted}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding SelectedBooking.StartParkingLotId}" FontFamily="Courier New" FontSize="13" />
                    <Label Grid.Row="0" Grid.Column="2" Text="Active:" FontFamily="Courier New" FontSize="13" TextColor="{StaticResource TextMuted}" />
                    <Label Grid.Row="0" Grid.Column="3" Text="{Binding SelectedBooking.IsActive}" FontFamily="Courier New" FontSize="13" />
                    <Label Grid.Row="1" Grid.Column="0" Text="Price:" FontFamily="Courier New" FontSize="13" TextColor="{StaticResource TextMuted}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBooking.TotalPrice, StringFormat='€ {0:F2}'}" FontFamily="Courier New" FontSize="13" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
