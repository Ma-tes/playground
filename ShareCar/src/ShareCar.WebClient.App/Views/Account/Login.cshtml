@model ShareCar.WebClient.App.Models.LoginViewModel
@{
  ViewData["Title"] = "Log in";
}

<div class="flex-1 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <span class="material-symbols-outlined text-5xl text-blue-600">directions_car</span>
      <h1 class="mt-3 text-2xl font-semibold">ShareCar</h1>
      <p class="mt-1 text-sm text-gray-500">Sign in to your account</p>
    </div>

    @if (TempData["Success"] is string success)
    {
      <div class="mb-4 rounded-md bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">check_circle</span>
        @success
      </div>
    }

    <form method="post" asp-action="Login" asp-controller="Account" novalidate class="space-y-5">
      @Html.AntiForgeryToken()
      <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

      @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
      {
        <div class="rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 flex items-center gap-2">
          <span class="material-symbols-outlined text-lg">error</span>
          @ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
        </div>
      }

      <div>
        <label asp-for="Username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl">person</span>
          <input asp-for="Username"
               class="block w-full rounded-md border border-gray-300 bg-white pl-10 pr-3 py-2.5 text-sm placeholder-gray-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
               placeholder="Enter your username" autocomplete="username" />
        </div>
        <span asp-validation-for="Username" class="text-xs text-red-600 mt-1 block"></span>
      </div>

      <div>
        <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl">lock</span>
          <input asp-for="Password"
               class="block w-full rounded-md border border-gray-300 bg-white pl-10 pr-3 py-2.5 text-sm placeholder-gray-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
               placeholder="Enter your password" autocomplete="current-password" />
        </div>
        <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
      </div>

      <button type="submit"
          class="w-full rounded-md bg-blue-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition">
        Sign in
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-gray-500">
      Don't have an account?
      <a asp-action="Register" asp-controller="Account" class="font-medium text-blue-600 hover:text-blue-500">Create one</a>
    </p>
  </div>
</div>
