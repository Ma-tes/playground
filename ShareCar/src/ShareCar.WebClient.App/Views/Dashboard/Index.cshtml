@model ShareCar.WebClient.App.Models.DashboardViewModel
@{
  ViewData["Title"] = "Dashboard";
}

<header class="bg-white border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between relative">
  <a asp-action="Index" asp-controller="Dashboard" class="flex items-center gap-2 text-gray-900 no-underline">
    <span style="display:inline-block;width:12px;height:12px;background:#D2691E;flex-shrink:0"></span>
    <span class="font-semibold text-gray-700" style="letter-spacing:0.12em">SHARECAR<span class="text-gray-400">.TERMINAL</span></span>
  </a>
  <nav class="absolute left-1/2 -translate-x-1/2 flex items-center gap-6" style="font-family: 'Instrument Serif', serif;">
    <a asp-action="Index" asp-controller="Dashboard" class="text-sm font-bold uppercase no-underline" style="letter-spacing:0.15em;color:#D2691E">Dashboard</a>
    <a asp-action="Search" asp-controller="Dashboard" class="text-sm font-bold uppercase text-gray-500 hover:text-gray-700 no-underline" style="letter-spacing:0.15em">Search</a>
    <a asp-action="Index" asp-controller="Profile" class="text-sm font-bold uppercase text-gray-500 hover:text-gray-700 no-underline" style="letter-spacing:0.15em">Profile</a>
  </nav>
  <form method="post" asp-action="Logout" asp-controller="Account" class="inline">
    @Html.AntiForgeryToken()
    <button type="submit" class="text-sm font-bold uppercase text-gray-500 hover:text-gray-700 transition" style="letter-spacing:0.15em">Sign out</button>
  </form>
  </div>
</header>

<main class="flex-1 max-w-5xl mx-auto w-full px-4 py-8">
  <h1 class="text-[44px] sm:text-[64px] md:text-[80px] leading-tight tracking-[-0.175px] text-black text-center font-semibold mb-6" style="font-family: 'Instrument Serif', serif;">
    A funny thing happens, when you design simple system.
  </h1>
  <div class="flex items-start justify-center gap-6 mb-8" style="font-family: 'Instrument Serif', serif;">
    <p class="text-sm leading-relaxed text-gray-600 max-w-[200px] text-right hidden md:block">
      The future of shared mobility starts here. A fleet management terminal built for simplicity — browse lots, pick a vehicle, and drive away. No paperwork, no hassle.
    </p>
    <img src="~/images/dashboard_image.png" alt="ShareCar Terminal" class="w-1/2 flex-shrink-0" />
    <p class="text-sm leading-relaxed text-gray-600 max-w-[200px] text-left hidden md:block">
      Every vehicle at your fingertips. Real-time availability across all parking lots, instant booking confirmations, and transparent pricing — car sharing the way it should be.
    </p>
  </div>

  @if (TempData["Success"] is string successMsg)
  {
  <div class="mb-4 rounded-md bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700 flex items-center gap-2">
    <span class="material-symbols-outlined text-lg">check_circle</span>
    @successMsg
  </div>
  }

  @if (TempData["Error"] is string errorMsg)
  {
  <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 flex items-center gap-2">
    <span class="material-symbols-outlined text-lg">error</span>
    @errorMsg
  </div>
  }

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    @foreach (var lot in Model.ParkingLots)
    {
    <a asp-action="Search" asp-controller="Dashboard" asp-route-parkingLotIds="@lot.Id"
       class="bg-white rounded-lg border border-gray-200 p-5 hover:border-blue-300 hover:shadow-sm transition no-underline text-gray-900 block">
      <div class="flex items-center gap-3 mb-3">
      <span class="material-symbols-outlined text-amber-600">local_parking</span>
      <h2 class="font-medium">@lot.Name</h2>
      </div>
      <p class="text-sm text-gray-500 mb-2">Capacity: @lot.TotalCapacity spots</p>
      <div class="flex items-center gap-1">
      <span class="material-symbols-outlined text-green-600 text-lg">directions_car</span>
      <span class="text-sm font-medium text-green-700">@lot.AvailableVehicles available</span>
      </div>
    </a>
    }
  </div>
</main>
