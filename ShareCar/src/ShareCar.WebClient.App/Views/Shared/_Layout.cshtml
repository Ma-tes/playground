<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — ShareCar.TERMINAL</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
  <link rel="stylesheet" href="~/css/flatpickr-blocked.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Courier Prime"', '"Courier New"', 'Courier', 'monospace'],
            mono: ['"Courier Prime"', '"Courier New"', 'Courier', 'monospace'],
          }
        }
      }
    }
  </script>
  <style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }
  </style>
</head>
<body class="font-sans text-gray-900 min-h-screen flex flex-col" style="background-color:#F6F1EE">
  @RenderBody()
  <dialog id="notifyDialog" class="rounded-lg border border-gray-200 p-0 shadow-xl backdrop:bg-black/50 w-full max-w-sm" style="font-family: inherit;">
    <div class="p-6">
      <div class="flex items-start gap-3 mb-4">
        <span id="notifyDialogIcon" class="material-symbols-outlined text-2xl mt-0.5"></span>
        <div>
          <h3 id="notifyDialogTitle" class="font-semibold text-gray-900"></h3>
          <p id="notifyDialogMessage" class="text-sm text-gray-600 mt-1"></p>
        </div>
      </div>
      <div class="flex justify-end">
        <button type="button" onclick="document.getElementById('notifyDialog').close()"
                class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition">
          OK
        </button>
      </div>
    </div>
  </dialog>

  <footer class="border-t border-gray-200 mt-auto">
    <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-center gap-2 text-sm text-gray-500">
      <span style="display:inline-block;width:12px;height:12px;background:#D2691E;flex-shrink:0"></span>
      <span class="font-semibold text-gray-700" style="letter-spacing:0.12em">SHARECAR<span class="text-gray-400">.TERMINAL</span></span>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.js"></script>
  <script src="~/js/vehicle-detail-flatpickr.js" asp-append-version="true"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
